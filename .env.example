# 値の後ろにコメントを書かない（コメントは前の行に書く）。<your-value> を書き換える
# Slack（manifest.yml で作ったアプリ）
# xoxb-…（OAuth & Permissions → Bot User OAuth Token）
SLACK_BOT_TOKEN=<your-value>
# xapp-…（Basic Information → App-Level Tokens、connections:write）
SLACK_APP_TOKEN=<your-value>
# 会議の登録・固定の議題・Canvas への出力・確定と中止ができる担当者（Slack のユーザー ID をカンマ区切り。例: U0123ABCD,U0456EFGH）
# 空なら、固定の議題・Canvas への出力・確定と中止は「その会議を登録した人だけ」ができる（会議の登録は誰でもできる）
# 議題を出す・見る・自分の議題の取り下げは誰でもできる。会議の変更と削除は、会議の登録者とここに書いた担当者
AGENDA_ADMINS=
# アジェンダの出し方: message（メッセージで投稿。既定）/ channel（チャンネルの Canvas を置き換える）/ standalone（開催日ごとに Canvas を作る）
# Canvas を API で作るには Slack の有料プランが必要。無料プランは message
CANVAS_MODE=message
# 「今日」と次の開催日を決めるタイムゾーン（IANA の名前）。サーバーが UTC でもこの日付で動く。未設定なら Asia/Tokyo
TIMEZONE=Asia/Tokyo
# 失敗を知らせる管理チャンネルの ID（例: C0123ABCD。ボットを招待しておく）。空ならログにだけ残す
ERROR_CHANNEL=
# DynamoDB（ローカルは DynamoDB Local。AWS で動かすときは DYNAMODB_ENDPOINT を空にする）
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_PREFIX=agenda_
AWS_REGION=ap-northeast-1
# AWS のアクセスキーはここに書かない。DynamoDB Local を使うとき（DYNAMODB_ENDPOINT あり）は、ボットがダミーの値を自動で使う。
# AWS で動かすときは IAM ロール（ECS のタスクロールなど）か AWS CLI のプロファイル（AWS_PROFILE）を使う
