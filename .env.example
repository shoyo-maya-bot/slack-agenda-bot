# Slack（manifest.yml で作ったアプリ）
SLACK_BOT_TOKEN=<your-value>      # xoxb-…（OAuth & Permissions）
SLACK_APP_TOKEN=<your-value>      # xapp-…（Basic Information → App-Level Tokens、connections:write）
# アジェンダの出し方: standalone（開催日ごとに Canvas を作る）/ channel（チャンネルの Canvas を置き換える）/ message（メッセージで投稿）
# Canvas を API で作るには Slack の有料プランが必要。無料プランは message
CANVAS_MODE=message
# DynamoDB（ローカルは DynamoDB Local。AWS で動かすときは DYNAMODB_ENDPOINT を空にする）
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_PREFIX=agenda_
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
